PORT=5000
# Use "production" on a real website (turns on the strict checks)
NODE_ENV=development
MONGO_URI=mongodb://127.0.0.1:27017/wastemanagement

# Required. At least 32 random characters. Generate with: npm run gen-secret
JWT_SECRET=paste_a_long_random_secret_here

# Websites allowed to call the API (comma separated). Add your real domain when you deploy.
CLIENT_URL=http://localhost:5173

# Set to 1 when the server is behind Nginx / Render / Railway / Cloudflare (needed for correct rate limiting)
#app.set('trust proxy', 1);
# Set to true only when your site runs on https://
# FORCE_HTTPS=false

# AI (Groq). Get a key at https://console.groq.com/keys
GROQ_API_KEY=your_groq_key
# Text model for admin insights. llama-3.3-70b-versatile was shut down by Groq on 16 Aug 2026.
GROQ_TEXT_MODEL=openai/gpt-oss-120b
# Vision model for the waste photo classifier. llama-4-scout was shut down on 17 Jul 2026.
GROQ_MODEL=qwen/qwen3.6-27b


